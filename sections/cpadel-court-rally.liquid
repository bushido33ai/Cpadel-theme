{%- comment -%}
  CPadel court rally: a padel court in real 3D (to scale, 20 m x 10 m),
  seen from a broadcast angle, with standing glass back walls, a mesh side
  wall and the net. A ball plays a rally over it in 3D, with its shadow on
  the turf, while the camera orbits as the section scrolls past.
  Motion lives in assets/cpadel-motion.js (<cpadel-court-rally>).

  Court units: 10 per metre, the floor is 200 x 100. Service lines are 6.95 m
  from the net (x = 30.5 and 169.5). Walls are 3 m of glass (30 units); the
  net is 0.88 m (8.8 units). The near side wall is left out so the court
  can be seen, as in a TV shot.
{%- endcomment -%}

<cpadel-court-rally class="cpadel-rally">
  <div class="cpadel-rally__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="cpadel-rally__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="cpadel-rally__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="cpadel-rally__court" data-court>
    <div class="cpadel-rally__scene" role="img" aria-label="A ball rallying across a padel court">
      <div class="cpadel-rally__plane" data-plane>
        <svg class="cpadel-rally__floor" viewBox="0 0 200 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <rect class="cpadel-rally__turf" x="0" y="0" width="200" height="100" />
          <g fill="none">
            <path class="cpadel-rally__line" data-court-line pathLength="1" d="M30.5 0 V100" />
            <path class="cpadel-rally__line" data-court-line pathLength="1" d="M169.5 0 V100" />
            <path class="cpadel-rally__line" data-court-line pathLength="1" d="M30.5 50 H169.5" />
            <path class="cpadel-rally__edge" data-court-line pathLength="1" d="M0 0 H200 V100 H0 Z" />
          </g>
          <polyline class="cpadel-rally__trail" data-ball-trail points="" fill="none" />
        </svg>

        <div class="cpadel-rally__wall cpadel-rally__wall--far" data-wall aria-hidden="true">
          <span class="cpadel-rally__glass-pane"></span>
          <span class="cpadel-rally__mesh-pane"></span>
          <span class="cpadel-rally__glass-pane"></span>
        </div>
        <div class="cpadel-rally__wall cpadel-rally__wall--end cpadel-rally__wall--left" data-wall aria-hidden="true">
          <span class="cpadel-rally__glass-pane"></span>
        </div>
        <div class="cpadel-rally__wall cpadel-rally__wall--end cpadel-rally__wall--right" data-wall aria-hidden="true">
          <span class="cpadel-rally__glass-pane"></span>
        </div>
        <div class="cpadel-rally__net" data-net aria-hidden="true"></div>

        <span class="cpadel-rally__shadow" data-ball-shadow aria-hidden="true"></span>
        <span class="cpadel-rally__ball" data-ball aria-hidden="true">
          <span class="cpadel-rally__ball-face"><span class="cpadel-rally__ball-skin" data-ball-body></span></span>
        </span>
      </div>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <ul class="cpadel-rally__specs" role="list">
      {%- for block in section.blocks -%}
        <li class="cpadel-rally__spec" data-court-spec {{ block.shopify_attributes }}>
          <span class="cpadel-rally__spec-index">{{ forloop.index | prepend: '0' }}</span>
          <div>
            <h3 class="cpadel-rally__spec-title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="cpadel-rally__spec-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</cpadel-court-rally>

{% stylesheet %}
  .cpadel-rally {
    --tilt: 60deg;
    --orbit: -24deg;
    --u: 4px; /* one court unit (10 cm) in pixels; set from the court width by JS */
    --bx: 150;
    --by: 62;
    --bz: 0;
    display: block;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
    background:
      radial-gradient(ellipse 70% 55% at 50% 62%, rgb(255 250 243 / 0.9), rgb(255 250 243 / 0) 70%),
      linear-gradient(#f4eee6, #eadfd0);
  }

  .cpadel-rally__header {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
  }

  .cpadel-rally__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--cpadel-burgundy, #6b1e24);
    font-family: var(--font-subheading--family);
    font-size: 0.8125rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  .cpadel-rally__heading {
    margin: 0;
  }

  .cpadel-rally__court {
    max-width: 68rem;
    margin: clamp(1rem, 3vw, 2.5rem) auto 0;
  }

  .cpadel-rally__scene {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    perspective: 1600px;
    perspective-origin: 50% 20%;
  }

  .cpadel-rally__plane {
    position: relative;
    width: 82%;
    aspect-ratio: 2 / 1;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt)) rotateZ(var(--orbit));
  }

  .cpadel-rally__floor {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 18px 30px rgb(43 22 24 / 0.18));
  }

  .cpadel-rally__turf {
    fill: #c97b5a; /* terracotta turf, like the court in the homepage photo */
  }

  .cpadel-rally__line {
    stroke: #fffaf3;
    stroke-width: 0.8;
    vector-effect: none;
  }

  .cpadel-rally__edge {
    stroke: #fffaf3;
    stroke-width: 0.6;
    opacity: 0.6;
  }

  .cpadel-rally__trail {
    stroke: #fffaf3;
    stroke-width: 0.5;
    stroke-dasharray: 1.4 1.8;
    opacity: 0.75;
  }

  /* Walls stand up out of the floor (rotate about the edge they sit on). */
  .cpadel-rally__wall {
    position: absolute;
    display: flex;
    transform-style: preserve-3d;
  }

  .cpadel-rally__wall--far {
    left: 0;
    top: 0;
    width: 100%;
    height: 30%; /* 3 m of the 10 m court depth */
    transform-origin: top center;
    transform: rotateX(90deg);
  }

  .cpadel-rally__wall--end {
    top: 0;
    width: 15%; /* 3 m of the 20 m court length */
    height: 100%;
  }

  .cpadel-rally__wall--left {
    left: 0;
    transform-origin: left center;
    transform: rotateY(-90deg);
  }

  .cpadel-rally__wall--right {
    right: 0;
    transform-origin: right center;
    transform: rotateY(90deg);
  }

  .cpadel-rally__glass-pane,
  .cpadel-rally__mesh-pane {
    flex: 1;
    border: 1px solid rgb(107 30 36 / 0.55);
  }

  .cpadel-rally__glass-pane {
    background: linear-gradient(160deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.12) 45%, rgb(255 255 255 / 0.3));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.4);
  }

  .cpadel-rally__wall--far .cpadel-rally__glass-pane {
    flex: 0 0 10%; /* 2 m of glass at each end of the side wall */
  }

  .cpadel-rally__mesh-pane {
    background:
      repeating-linear-gradient(90deg, rgb(43 22 24 / 0.35) 0 1px, transparent 1px 8px),
      repeating-linear-gradient(0deg, rgb(43 22 24 / 0.35) 0 1px, transparent 1px 8px);
    border-color: rgb(43 22 24 / 0.5);
  }

  .cpadel-rally__net {
    position: absolute;
    top: 0;
    left: 50%;
    width: 4.4%; /* 0.88 m */
    height: 100%;
    transform-origin: left center;
    transform: rotateY(-90deg);
    background:
      repeating-linear-gradient(90deg, rgb(43 22 24 / 0.55) 0 1px, transparent 1px 5px),
      repeating-linear-gradient(0deg, rgb(43 22 24 / 0.55) 0 1px, transparent 1px 5px);
    border-left: 3px solid #fffaf3; /* the tape along the top of the net */
  }

  .cpadel-rally__shadow,
  .cpadel-rally__ball {
    position: absolute;
    left: calc(var(--bx) * 0.5%);
    top: calc(var(--by) * 1%);
    width: calc(var(--u) * 6.5);
    height: calc(var(--u) * 6.5);
    margin: calc(var(--u) * -3.25) 0 0 calc(var(--u) * -3.25);
    pointer-events: none;
  }

  .cpadel-rally__shadow {
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(43 22 24 / 0.5), rgb(43 22 24 / 0));
    transform: scale(calc(1 + var(--bz) / 30));
    opacity: calc(1 - var(--bz) / 45);
  }

  .cpadel-rally__ball {
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--bz) * var(--u) + var(--u) * 3.25));
  }

  .cpadel-rally__ball-face {
    position: absolute;
    inset: 0;
    /* Undo the court's rotation so the ball always faces the camera. */
    transform: rotateZ(calc(var(--orbit) * -1)) rotateX(calc(var(--tilt) * -1));
  }

  .cpadel-rally__ball-skin {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #fbffd0 0 12%, #e4ef5d 40%, #b5c33a 78%, #8d9a2a 100%);
    box-shadow: inset -2px -3px 6px rgb(0 0 0 / 0.18);
  }

  .cpadel-rally__specs {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    max-width: 68rem;
    margin: clamp(1.5rem, 4vw, 3rem) auto 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .cpadel-rally__specs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .cpadel-rally__spec {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid #d8c7b3;
  }

  .cpadel-rally__spec-index {
    color: var(--cpadel-burgundy, #6b1e24);
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    line-height: 1;
  }

  .cpadel-rally__spec-title {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .cpadel-rally__spec-text {
    margin: 0.4rem 0 0;
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .cpadel-rally__scene {
      aspect-ratio: 4 / 3;
    }

    .cpadel-rally__plane {
      width: 92%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CPadel court rally",
  "tag": "section",
  "class": "cpadel-rally-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above heading",
      "default": "On court"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for every rally"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "3K Carbon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "A woven carbon face for a crisp, responsive feel."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CPadel court rally",
      "blocks": [
        { "type": "spec", "settings": { "title": "3K Carbon", "text": "A woven carbon face for a crisp, responsive feel." } },
        { "type": "spec", "settings": { "title": "Pro Core", "text": "A core tuned for comfort through long rallies." } },
        { "type": "spec", "settings": { "title": "Control Series", "text": "Shaped for placement and touch at the net." } }
      ]
    }
  ]
}
{% endschema %}
