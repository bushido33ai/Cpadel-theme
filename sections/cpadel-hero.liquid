{%- comment -%}
  CPadel hero: a full-bleed photo of a sunlit padel court with a racket
  standing on it, a headline, a short line of copy and up to two buttons.

  If no image is chosen in the theme editor, it falls back to the court
  photo bundled with the theme (assets/cpadel-court-sun-*.jpg).
{%- endcomment -%}

{%- liquid
  assign heading_tag = 'h1'
  unless section.index == 1
    assign heading_tag = 'h2'
  endunless
-%}

{%- liquid
  assign play_intro = false
  if section.settings.play_intro and section.index == 1 and request.design_mode == false
    assign play_intro = true
  endif
-%}

<cpadel-hero-motion class="cpadel-hero-motion" data-play-intro="{{ play_intro }}">
  {%- if play_intro -%}
    <script>
      // Decide before first paint whether the opening sequence plays, so the
      // overlay never flashes. It plays once per visit, never for reduced motion,
      // and a failsafe removes it if the motion script doesn't start.
      (function () {
        try {
          var root = document.documentElement;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (sessionStorage.getItem('cpadel-intro-seen')) return;
          root.classList.add('cpadel-intro-pending');
          setTimeout(function () {
            if (!window.cpadelIntroStarted) root.classList.remove('cpadel-intro-pending');
          }, 4000);
        } catch (e) {}
      })();
    </script>
    <div class="cpadel-intro" data-intro aria-hidden="true">
      <div class="cpadel-intro__panel cpadel-intro__panel--burgundy" data-intro-panel-back></div>
      <div class="cpadel-intro__panel cpadel-intro__panel--cream" data-intro-panel>
        <div class="cpadel-intro__mark" data-intro-mark>
          <div class="cpadel-intro__emblem">
            <img class="cpadel-intro__c" data-intro-c src="{{ 'cpadel-emblem-c-burgundy.png' | asset_url }}" alt="" width="226" height="192">
            <img class="cpadel-intro__crown" data-intro-crown src="{{ 'cpadel-emblem-crown-burgundy.png' | asset_url }}" alt="" width="226" height="192">
          </div>
          <img class="cpadel-intro__wordmark" data-intro-wordmark src="{{ 'cpadel-wordmark-burgundy.png' | asset_url }}" alt="" width="765" height="77">
          <span class="cpadel-intro__rule" data-intro-rule></span>
        </div>
      </div>
    </div>
  {%- endif -%}

<section
  class="cpadel-hero cpadel-hero--{{ section.settings.height }} cpadel-hero--{{ section.settings.text_position }}"
  style="--cpadel-hero-focus: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%; --cpadel-hero-shade: {{ section.settings.shade | divided_by: 100.0 }};"
>
  <div class="cpadel-hero__media" data-hero-media>
    {%- if section.settings.image != blank -%}
      {%- assign image_class = 'cpadel-hero__image' -%}
      {{-
        section.settings.image
        | image_url: width: 3200
        | image_tag:
          class: image_class,
          widths: '750, 1100, 1500, 2000, 2600, 3200',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt
      -}}
    {%- else -%}
      <picture>
        <source media="(max-width: 749px)" srcset="{{ 'cpadel-court-sun-1200.jpg' | asset_url }}">
        <img
          class="cpadel-hero__image"
          src="{{ 'cpadel-court-sun-2048.jpg' | asset_url }}"
          alt="An empty padel court in the afternoon sun"
          width="2048"
          height="1152"
          loading="eager"
          fetchpriority="high"
        >
      </picture>
    {%- endif -%}
  </div>

  {%- if section.settings.show_racket -%}
    {%- liquid
      if section.settings.racket_image != blank
        assign hero_racket_src = section.settings.racket_image | image_url: width: 1200
        assign hero_racket_w = section.settings.racket_image.width
        assign hero_racket_h = section.settings.racket_image.height
      else
        assign hero_racket_src = 'cpadel-racket-cutout.webp' | asset_url
        assign hero_racket_w = 697
        assign hero_racket_h = 1308
      endif
    -%}
    <div class="cpadel-hero__racket" data-hero-racket style="--hero-racket-ratio: {{ hero_racket_w }} / {{ hero_racket_h }};">
      <span class="cpadel-hero__racket-shadow" data-hero-racket-shadow aria-hidden="true"></span>
      <div class="cpadel-hero__racket-float" data-hero-racket-float>
        <img
          class="cpadel-hero__racket-image"
          src="{{ hero_racket_src }}"
          alt="{{ section.settings.racket_alt | escape }}"
          width="{{ hero_racket_w }}"
          height="{{ hero_racket_h }}"
          loading="eager"
          fetchpriority="high"
        >
      </div>
    </div>
  {%- endif -%}

  <div class="cpadel-hero__content">
    <div class="cpadel-hero__inner" data-hero-content>
      {%- if section.settings.show_emblem -%}
        <img
          class="cpadel-hero__emblem"
          src="{{ 'cpadel-emblem-cream.png' | asset_url }}"
          alt=""
          width="226"
          height="192"
        >
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="cpadel-hero__eyebrow" data-hero-fade>{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="cpadel-hero__heading" data-hero-heading>{{ section.settings.heading }}</{{ heading_tag }}>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="cpadel-hero__text" data-hero-fade>{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button_2_label != blank -%}
        <div class="cpadel-hero__buttons" data-hero-fade>
          {%- if section.settings.button_label != blank -%}
            <a data-magnetic class="button cpadel-hero__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
              {{- section.settings.button_label -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a data-magnetic class="button button-secondary cpadel-hero__button cpadel-hero__button--ghost" href="{{ section.settings.button_2_link | default: '#our-story' }}">
              {{- section.settings.button_2_label -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
</cpadel-hero-motion>

{% stylesheet %}
  .cpadel-hero {
    position: relative;
    display: grid;
    overflow: hidden;
    isolation: isolate;
    color: #fffaf3;
    background: #c9a784;
  }

  /*
    Heights are set from the window, less the announcement bar above the
    hero (Horizon's --header-group-height), so the copy and buttons sit on
    the first screen. The photo fills whatever height that gives.
  */
  .cpadel-hero--full {
    min-height: max(calc(100svh - var(--header-group-height, 0px)), 34rem);
  }

  .cpadel-hero--large {
    min-height: max(calc(82svh - var(--header-group-height, 0px)), 30rem);
  }

  .cpadel-hero--medium {
    min-height: max(calc(64svh - var(--header-group-height, 0px)), 26rem);
  }

  .cpadel-hero__media,
  .cpadel-hero__content {
    grid-area: 1 / 1;
  }

  .cpadel-hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cpadel-hero__media picture,
  .cpadel-hero__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cpadel-hero__image {
    object-fit: cover;
    object-position: var(--cpadel-hero-focus, 50% 50%);
  }

  /* A warm wash from the bottom-left keeps the text legible on bright sun. */
  .cpadel-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgb(43 22 24 / calc(var(--cpadel-hero-shade) * 1.1)) 0%,
        rgb(43 22 24 / calc(var(--cpadel-hero-shade) * 0.35)) 45%,
        rgb(43 22 24 / 0) 75%
      );
  }

  .cpadel-hero__content {
    display: flex;
    align-items: flex-end;
    padding-block: clamp(3rem, 10vh, 7rem);
    padding-inline: clamp(1.25rem, 6vw, 6rem);
  }

  .cpadel-hero--center .cpadel-hero__content {
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .cpadel-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    text-shadow: 0 1px 24px rgb(43 22 24 / 0.35);
  }

  .cpadel-hero--center .cpadel-hero__inner {
    margin-inline: auto;
  }

  .cpadel-hero__emblem {
    display: block;
    width: clamp(3rem, 5vw, 4.5rem);
    height: auto;
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 2px 16px rgb(43 22 24 / 0.35));
  }

  .cpadel-hero--center .cpadel-hero__emblem {
    margin-inline: auto;
  }

  .cpadel-hero__eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-subheading--family);
    font-size: 0.8125rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  .cpadel-hero__heading {
    margin: 0;
    color: inherit;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(2.5rem, 5.2vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cpadel-hero__text {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .cpadel-hero__text p {
    margin: 0;
  }

  .cpadel-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .cpadel-hero--center .cpadel-hero__buttons {
    justify-content: center;
  }

  .cpadel-hero__button {
    text-shadow: none;
  }

  .cpadel-hero .cpadel-hero__button--ghost {
    background: transparent;
    color: #fffaf3;
    border-color: #fffaf3;
  }

  .cpadel-hero .cpadel-hero__button--ghost:hover {
    background: #fffaf3;
    color: var(--cpadel-ink, #2b1618);
    border-color: #fffaf3;
  }

  /*
    The racket stands on the court, to the right of the copy. Desktop: tall,
    on the right. Phones: smaller, top right, above the copy.
  */
  .cpadel-hero__racket {
    position: absolute;
    right: clamp(1.5rem, 9vw, 11rem);
    bottom: clamp(2.5rem, 8vh, 5.5rem);
    z-index: 0;
    height: min(72svh, 44rem);
    aspect-ratio: var(--hero-racket-ratio);
    pointer-events: none;
  }

  .cpadel-hero__racket-float {
    position: relative;
    width: 100%;
    height: 100%;
    transform: rotate(-7deg);
    transform-origin: 50% 90%;
  }

  .cpadel-hero__racket-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 28px 34px rgb(43 22 24 / 0.45));
  }

  .cpadel-hero__racket-shadow {
    position: absolute;
    left: 50%;
    bottom: -3%;
    width: 85%;
    height: 7%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(43 22 24 / 0.55), rgb(43 22 24 / 0));
    transform: translateX(-50%);
  }

  @media screen and (max-width: 989px) {
    .cpadel-hero__racket {
      right: clamp(1rem, 5vw, 3rem);
      height: min(58svh, 34rem);
    }
  }

  @media screen and (max-width: 749px) {
    .cpadel-hero__racket {
      top: calc(var(--header-group-height, 0px) + var(--header-height, 60px) + 0.75rem);
      right: 7vw;
      bottom: auto;
      height: min(24svh, 13rem);
    }

    .cpadel-hero__content {
      padding-block: 2rem 2.25rem;
    }

    .cpadel-hero__heading {
      font-size: clamp(2.25rem, 10vw, 2.75rem);
    }

    .cpadel-hero__text {
      margin-top: 0.9rem;
      font-size: 1rem;
    }

    .cpadel-hero__buttons {
      flex-wrap: nowrap;
      gap: 0.6rem;
      margin-top: 1.5rem;
    }

    .cpadel-hero .cpadel-hero__button {
      flex: 1 1 auto;
      padding-inline: 1rem;
      letter-spacing: 0.14em;
      white-space: nowrap;
    }

    .cpadel-hero__racket-shadow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :root:not(.cpadel-motion) .cpadel-hero__image {
      animation: cpadel-hero-settle 2.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    :root:not(.cpadel-motion) .cpadel-hero__inner {
      animation: cpadel-hero-rise 1.2s 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }

  cpadel-hero-motion {
    display: block;
  }

  /* Opening sequence (only shown while html.cpadel-intro-pending) */
  .cpadel-intro {
    display: none;
  }

  .cpadel-intro-pending {
    overflow: hidden;
  }

  .cpadel-intro-pending .cpadel-intro {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 2147483000;
  }

  .cpadel-intro__panel {
    position: absolute;
    inset: 0;
  }

  .cpadel-intro__panel--burgundy {
    background: #6b1e24;
  }

  .cpadel-intro__panel--cream {
    display: grid;
    place-items: center;
    background: #f4eee6;
  }

  .cpadel-intro__mark {
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 4vh, 2.5rem);
    width: min(80vw, 34rem);
  }

  .cpadel-intro__emblem {
    position: relative;
    width: clamp(7rem, 18vw, 11rem);
    aspect-ratio: 226 / 192;
  }

  .cpadel-intro__emblem img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cpadel-intro__wordmark {
    width: 100%;
    height: auto;
  }

  .cpadel-intro__rule {
    display: block;
    width: 3.5rem;
    height: 1px;
    background: #6b1e24;
  }

  .cpadel-hero__heading .cpadel-char-mask {
    padding-bottom: 0.08em;
  }

  @keyframes cpadel-hero-settle {
    from {
      transform: scale(1.06);
    }

    to {
      transform: scale(1);
    }
  }

  @keyframes cpadel-hero-rise {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CPadel hero",
  "tag": "div",
  "class": "cpadel-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Leave empty to use the sunlit court photo that comes with the theme."
    },
    {
      "type": "range",
      "id": "focal_x",
      "label": "Image focus (left to right)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focal_y",
      "label": "Image focus (top to bottom)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "shade",
      "label": "Shade behind text",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "checkbox",
      "id": "play_intro",
      "label": "Play opening sequence",
      "info": "Crowned C and wordmark animate in, then the page is revealed. Plays once per visit, only when this is the first section, and never in the theme editor.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_racket",
      "label": "Show racket",
      "info": "Stands a racket cut-out on the court beside the copy. Best with a photo that leaves room on the right.",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "racket_image",
      "label": "Racket cut-out",
      "info": "A PNG or WebP with a transparent background. Leave empty to use the bundled Control Series cut-out."
    },
    {
      "type": "text",
      "id": "racket_alt",
      "label": "Racket description",
      "default": "The CPadel Control Series padel racket"
    },
    {
      "type": "checkbox",
      "id": "show_emblem",
      "label": "Show crowned C emblem",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above heading",
      "default": "Premium padel rackets"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for the court"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Padel rackets crafted for control, comfort and long summer sets.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop rackets"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link"
    }
  ],
  "presets": [
    {
      "name": "CPadel hero"
    }
  ]
}
{% endschema %}
