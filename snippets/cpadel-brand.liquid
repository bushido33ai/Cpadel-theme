{%- comment -%}
  CPadel brand layer. Loaded after Horizon's theme variables so it can widen
  heading tracking and add burgundy details without editing core Horizon files.
{%- endcomment -%}
{% style %}
  :root {
    /* Colours taken from the CPadel Control Series racket. */
    --cpadel-burgundy: {{ settings.color_palette.color1 | default: '#6B1E24' }};
    --cpadel-oxblood: #3F1B19;
    --cpadel-cream: {{ settings.color_palette.background | default: '#F4EEE6' }};
    --cpadel-sand: #C9A784;
    --cpadel-ink: {{ settings.color_palette.foreground | default: '#2B1618' }};

    /* The CPadel wordmark is widely spaced; headings follow suit. */
    --letter-spacing--heading-loose: 0.18em;
    --letter-spacing--display-loose: 0.14em;
  }

  /* Buttons: wide-tracked capitals, like the current CPadel store. */
  .button,
  .button-secondary,
  button.button,
  .shopify-payment-button__button--unbranded {
    letter-spacing: 0.22em;
  }

  /* Burgundy focus ring and link hover. */
  :focus-visible {
    outline-color: var(--cpadel-burgundy);
  }

  .rte a:hover,
  .menu-list__link:hover,
  .footer a:hover {
    color: var(--cpadel-burgundy);
  }

  /* Primary buttons deepen to the strap's oxblood on hover. */
  .button:not(.button-secondary):hover {
    background-color: var(--cpadel-oxblood);
    border-color: var(--cpadel-oxblood);
  }

  /*
    Motion (assets/cpadel-motion.js). Horizon scrolls .page-wrapper on desktop;
    CSS smooth scrolling there fights ScrollTrigger's measurements, so it is
    switched off while the motion is running, and the opening sequence locks
    whichever element is scrolling.
  */
  html.cpadel-motion,
  html.cpadel-motion .page-wrapper {
    scroll-behavior: auto;
  }

  html.cpadel-intro-pending .page-wrapper {
    overflow: hidden;
  }

  ::selection {
    background: var(--cpadel-burgundy);
    color: var(--cpadel-cream);
  }
{% endstyle %}
